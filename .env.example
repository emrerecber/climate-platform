# Database
DATABASE_URL="postgresql://username:password@localhost:5432/climate_platform_db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Application
NODE_ENV="development"
PORT=3001

# File Upload
MAX_FILE_SIZE="10mb"
UPLOAD_DIR="./uploads"

# External APIs (Optional - for future integrations)
TCMB_API_KEY=""
NGFS_API_KEY=""
WEATHER_API_KEY=""

# Email Configuration (Optional)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Monitoring (Optional)
SENTRY_DSN=""
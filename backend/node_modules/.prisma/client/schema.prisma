generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  company   String?
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assessments   Assessment[]
  pactaAnalyses PACTAAnalysis[]
  reports       Report[]

  @@map("users")
}

model Assessment {
  id              String           @id @default(cuid())
  userId          String
  companyName     String
  sector          String
  revenue         Float?
  employees       Int?
  geography       String
  status          AssessmentStatus @default(IN_PROGRESS)
  currentStep     Int              @default(1)
  totalSteps      Int              @default(5)
  assessmentData  Json             @default("{}")
  riskScores      Json?
  recommendations Json?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports Report[]

  @@map("assessments")
}

model PACTAAnalysis {
  id              String              @id @default(cuid())
  userId          String
  portfolioName   String?
  portfolioData   Json
  scenario        String              @default("nze_2050")
  sectors         String[]
  status          PACTAAnalysisStatus @default(PENDING)
  uploadId        String?
  filename        String?
  fileFormat      String?             @default("csv")
  recordsCount    Int?
  analysisResults Json?
  alignmentScore  Float?
  gapToTarget     Float?
  recommendations Json?
  calculatedAt    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pacta_analyses")
}

model Report {
  id           String     @id @default(cuid())
  userId       String
  assessmentId String?
  title        String
  reportType   ReportType
  format       String     @default("pdf")
  content      Json
  fileUrl      String?
  isPublic     Boolean    @default(false)
  generatedAt  DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@map("reports")
}

model ClimateBenchmark {
  id          String   @id @default(cuid())
  sector      String
  technology  String
  scenario    String
  year        Int
  targetValue Float
  unit        String
  source      String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sector, technology, scenario, year])
  @@map("climate_benchmarks")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// Enums
enum UserRole {
  USER
  ADMIN
  ENTERPRISE
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum PACTAAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReportType {
  CLIMATE_ASSESSMENT
  PACTA_ANALYSIS
  PORTFOLIO_ALIGNMENT
  REGULATORY_COMPLIANCE
  CUSTOM
}
